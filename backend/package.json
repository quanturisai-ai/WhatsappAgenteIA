{
  "name": "agente-zap-backend",
  "version": "1.0.0",
  "description": "Backend para Agente Zap - Sistema de atendimento automatizado via WhatsApp com IA local",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/config', {recursive: true}); require('fs').copyFileSync('src/config/database.schema.sql', 'dist/config/database.schema.sql')\"",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test:vmhub": "ts-node-dev --transpile-only --no-notify test-vmhub-login.ts",
    "init-fidelizacao-defaults": "ts-node src/scripts/initFidelizacaoDefaults.ts",
    "test:scheduler": "ts-node src/scripts/test-vmLav-scheduler.ts",
    "diagnose:fidelidade": "ts-node --transpile-only src/scripts/diagnose-fidelidade-marcacao.ts",
    "diagnose:fidelidade-movimentos": "ts-node --transpile-only src/scripts/diagnose-fidelidade-por-movimentos.ts",
    "sync:voucher-movimentos": "ts-node --transpile-only src/scripts/sync-voucher-movimentos.ts",
    "check:voucher-list": "ts-node --transpile-only src/scripts/check-voucher-list.ts",
    "test:gerar-voucher": "ts-node --transpile-only src/scripts/test-gerar-voucher.ts",
    "test:token-renewal": "ts-node src/scripts/test-vmLav-token-renewal.ts",
    "test:incentivo-dia-util": "ts-node --transpile-only src/scripts/test-incentivo-dia-util.ts",
    "verificar:progresso": "ts-node --transpile-only src/scripts/verificar-progresso-fidelizacao.ts",
    "diagnostico:progresso-08-03": "ts-node --transpile-only src/scripts/diagnostico-progresso-08032026.ts",
    "test:ollama-keepalive": "ts-node test-ollama-keepalive.ts"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "ollama",
    "rag",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/ollama": "^0.2.4",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.0.2",
    "mammoth": "^1.6.0",
    "mariadb": "^3.2.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.34.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.2",
    "whatsapp-web.js": "^1.34.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/puppeteer": "^7.0.4",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
