SYNCZ_BASE_URL=
SYNCZ_API_KEY=
SYNCZ_INSTANCE_ID=
WHATSAPP_PROVIDER=

# --- Plano de turnos (02/11/2026). Ausente/valor antigo = comportamento antigo. ---
# Números de teste do dono (lista separada por vírgula), usados nos modos "test".
AGENTE_TEST_NUMBERS=
# Item 0: grava a mensagem enviada na conversa que a enviou (casando o eco pelo registro do envio).
# off = antigo (resolve pelo contato) | test = só AGENTE_TEST_NUMBERS | on = todos
# Só tem efeito com WHATSAPP_PROVIDER=synczap (no whatsapp-web.js fica o caminho antigo).
OUTGOING_ECHO_BINDING=off
# #contatoia / CONTATO_PROATIVO: on = só dono (CONTATOIA_OWNER_NUMBERS) ou atendente ativo;
# para os demais o comando é retirado e nada é enviado a terceiros. off = antigo (qualquer um).
CONTATOIA_RESTRICT=off
CONTATOIA_OWNER_NUMBERS=
# Item 1: on = grava uma linha JSON por turno da IA em logs/turnos.jsonl (tokens, cache, custo,
# modelo, ms por etapa; sem conteúdo de mensagem). off = antigo. TURN_METRICS_FILE troca o arquivo.
TURN_METRICS=off
# Teste de ponta a ponta: on = POST /api/conversations/:id/simulate-incoming roda um turno da IA,
# só para conversas de AGENTE_TEST_NUMBERS. Manter off fora dos testes.
AGENTE_TEST_ENDPOINT=off
# Com viaScheduler=true no corpo, grava a mensagem como recebida e a põe na fila do agendador (item 2).
# Item 2: agendador de turnos. off = antigo (janela fixa MESSAGE_DEBOUNCE_MS, sem trava, um 2º turno
# pode rodar em paralelo) | test = só AGENTE_TEST_NUMBERS | on = todos. Ligado: espera DEBOUNCE_BASE_MS
# após a última mensagem (DEBOUNCE_GREETING_MS se for só saudação curta sem "?"), nunca mais que
# DEBOUNCE_MAX_MS desde a 1ª; um turno por conversa; mensagem nova cancela o turno e refaz com tudo junto.
TURN_SCHEDULER=off
DEBOUNCE_BASE_MS=5000
DEBOUNCE_GREETING_MS=8000
DEBOUNCE_MAX_MS=15000
# Anti-loop (só com TURN_SCHEDULER ligado): mais de ANTILOOP_MAX_IN mensagens do cliente em
# ANTILOOP_IN_WINDOW_MS, ou mais de ANTILOOP_MAX_OUT respostas em ANTILOOP_OUT_WINDOW_MS, pausa a IA
# da conversa, marca intervenção e avisa os atendentes (não avisa de novo por ANTILOOP_COOLDOWN_MS).
ANTILOOP=off
ANTILOOP_MAX_IN=8
ANTILOOP_IN_WINDOW_MS=120000
ANTILOOP_MAX_OUT=20
ANTILOOP_OUT_WINDOW_MS=600000
ANTILOOP_COOLDOWN_MS=1800000
# Prazo de um turno do agendador. Passou dele sem enviar: cancela e refaz o lote (até 2x; depois
# desiste e marca intervenção). Passou enviando (ex.: SyncZap pendurado): marca intervenção e espera;
# em 2x o prazo pausa a IA da conversa, avisa os atendentes e libera a fila.
# Reserva: mensagem chegando (áudio sendo transcrito) segura a fila até entrar nela.
TURN_DEADLINE_MS=150000
TURN_HOLD_MAX_MS=60000

# Item 3 (02/11/2026): histórico da conversa como mensagens user/assistant (off = prompt antigo:
# histórico narrativo de 10 msgs dentro do texto, 2 buscas RAG e resumo após 24 h).
# test = só AGENTE_TEST_NUMBERS; on = todos. Mensagens seguidas do mesmo lado são juntadas e o
# lote atual vai uma vez só (última mensagem do cliente). Uma busca RAG por turno.
HISTORY_MESSAGES=off
# Limites do histórico (só com HISTORY_MESSAGES ligado): últimas N mensagens dentro de X horas.
HISTORY_MAX_MESSAGES=30
HISTORY_MAX_AGE_HOURS=72

# Item 4 (02/11/2026): regras em agente/agente.yaml + system fixo com a base de conhecimento inteira.
# true (padrão) = antigo: busca RAG (embedding) a cada turno e só os trechos achados no prompt.
# test = só AGENTE_TEST_NUMBERS usam o system fixo; false = todos. Com o system fixo: persona, regras,
# comandos e handoff do agente.yaml + painel + tópicos e mídias ativos (ordem de id), sempre iguais
# (pega o cache do provedor); data/hora até o minuto, cliente, fidelidade e vouchers vão num bloco
# [contexto do turno] na última mensagem; #contatoia só no prompt do dono/atendente; nenhum embedding.
# Usa o histórico em mensagens (item 3). Se o agente.yaml falhar ao carregar, o turno usa o antigo.
RAG_ENABLED=true
# AGENTE_YAML_PATH=   (padrão: backend/agente/agente.yaml)
# Limite do system fixo; acima disso o turno volta ao prompt antigo (RAG) e registra erro no log.
AGENTE_SYSTEM_MAX_CHARS=120000
# JSON enviado à OpenRouter. v1 (padrão) = antigo. v2 = session_id por conversa (conv-<id>), sem
# usage.include (obsoleto), sem top_k/repetition_penalty, max_tokens = OPENROUTER_MAX_TOKENS.
# yaml = v2 só nos turnos que usam o agente.yaml (rollout junto com RAG_ENABLED=test); v2 = todos.
OPENROUTER_PAYLOAD=v1
OPENROUTER_MAX_TOKENS=1024
# Roteamento de fornecedor (só com OPENROUTER_PAYLOAD=v2). sort (padrão) = antigo, provider.sort =
# OPENROUTER_PROVIDER_SORT (throughput se vazio); default = roteamento balanceado do OpenRouter;
# price = mais barato, rebaixando os lentos (preferências p90, não bloqueiam) e com preço máximo em
# US$/milhão de tokens (BLOQUEIA se nenhum fornecedor couber).
OPENROUTER_PROVIDER_MODE=sort
OPENROUTER_PROVIDER_SORT=
OPENROUTER_PREFERRED_MAX_LATENCY_P90=3
OPENROUTER_PREFERRED_MIN_THROUGHPUT_P90=50
# Cuidado: max_price (US$/milhão de tokens) baixo demais elimina todos os fornecedores e o turno
# cai na resposta de fallback. Vazio (padrão) = sem limite. Valores sugeridos na proposta: 0.3 e 1.
OPENROUTER_MAX_PRICE_PROMPT=
OPENROUTER_MAX_PRICE_COMPLETION=

# ===== Item 5 (02/11/2026): multimodal (foto/vídeo do cliente vai ao modelo) =====
# off (padrão) = antigo (modelo do painel, mídia vira "[media]"); test = só AGENTE_TEST_NUMBERS;
# on = todos. Só vale nos turnos do agente.yaml (RAG_ENABLED=false/test). Ligado:
# - o modelo passa a ser OPENROUTER_GENERATION_MODEL (o do painel é ignorado nesses turnos);
# - se o modelo começar com um prefixo de AGENTE_MULTIMODAL_MODELOS, as fotos/vídeos do lote vão junto
#   (base64), a chamada leva provider.data_collection=OPENROUTER_DATA_COLLECTION e cada foto/vídeo ganha
#   na chegada uma descrição curta (tabela media_descricoes) que o histórico mostra em 1 linha;
# - vídeo acima de MIDIA_VIDEO_MAX_MB (ou que estoure MIDIA_MAX_REQUEST_BYTES) vira "[vídeo recebido]"
#   e o atendente é chamado. Áudio continua com a transcrição.
# Volta imediata: AGENTE_MULTIMODAL=off (ou um modelo só-texto em OPENROUTER_GENERATION_MODEL).
AGENTE_MULTIMODAL=off
# OPENROUTER_GENERATION_MODEL=google/gemini-2.5-flash-lite
AGENTE_MULTIMODAL_MODELOS=google/gemini-
# deny = só fornecedores que não guardam/treinam com os dados (zdr não existe para o gemini-2.5-flash-lite).
OPENROUTER_DATA_COLLECTION=deny
# MB decimal (14 = 14.000.000 bytes). O Google recusa corpo acima de 20.000.000 bytes e o base64 soma
# 33%: 14 MB vira 18,7 MB e cabe em MIDIA_MAX_REQUEST_BYTES (o de 17,7 MB deu 413 no teste).
MIDIA_VIDEO_MAX_MB=14
MIDIA_IMAGEM_MAX_MB=7
MIDIA_MAX_POR_TURNO=4
MIDIA_MAX_REQUEST_BYTES=19000000
# Descrição na chegada: on (padrão) | off. MIDIA_DESCRICAO_MODELO vazio = OPENROUTER_GENERATION_MODEL.
MIDIA_DESCRICAO=on
MIDIA_DESCRICAO_MODELO=
MIDIA_DESCRICAO_TIMEOUT_MS=45000

# ===== Item 6 (02/11/2026): ferramentas nativas (function calling) =====
# off (padrão) = antigo (comandos no texto [ENVIAR_MIDIA:ID], [ALERTAR_ATENDENTE: ...] lidos por regex);
# test = só AGENTE_TEST_NUMBERS; on = todos. Só nos turnos do agente.yaml com payload v2.
# Ligado: o modelo recebe as tools enviar_midia(id), chamar_atendente(motivo, resumo) e, só para
# dono/atendente autorizado (#contatoia), contato_proativo(numero, mensagem). No máximo
# AGENTE_TOOLS_MAX_CHAMADAS chamadas ao LLM por turno; passou disso, chama um atendente e responde
# um texto fixo de espera. Volta imediata: AGENTE_TOOLS=off.
AGENTE_TOOLS=off
AGENTE_TOOLS_MAX_CHAMADAS=3
# on (padrão) = com tools ligadas, comandos escritos no texto ainda são executados (reserva);
# off = só as tools valem (os comandos do texto só são apagados da resposta).
AGENTE_TOOLS_REGEX=on
# Chamar atendente pausa a IA na conversa? off (padrão, antigo) | test | on. Só pausa se, além disso,
# agente.yaml handoff.pausar_ia = true e o painel não tiver "pausar quando humano responde" desligado.
# Reativação da IA: pelo painel.
CHAMAR_ATENDENTE_PAUSA=off
# Números (vírgula) cujas ações viram só log: alerta a atendente e contato proativo NÃO são enviados.
# Para testes ponta a ponta sem acordar atendente real. Vazio (padrão) = antigo.
AGENTE_ACOES_SIMULADAS=
# on = a IA só envia mídia do catálogo (ativa, de saída, do mesmo usuário); off (padrão, antigo) =
# qualquer mídia pronta do usuário, inclusive foto recebida de outro cliente.
ENVIAR_MIDIA_CATALOGO=off
# Só com RAG_ENABLED=true: on = a busca vetorial acha a mídia pelo metadata.id (12 de 18 mídias
# indexadas não tinham media_id e nunca apareciam) e só traz mídia do catálogo. off (padrão) = antigo.
RAG_MIDIA_ID_FIX=off
